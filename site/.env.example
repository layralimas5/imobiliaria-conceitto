# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel.
# Sem nenhuma dessas variáveis o site roda normalmente: o lead é validado e
# gravado no log do servidor, com um aviso. Nada quebra, mas ninguém recebe.

# --- Entrega de lead por e-mail (Resend) ---
# 1. Crie a conta em resend.com e verifique o domínio imobiliariaconceitto.com.br
# 2. Gere uma API key em Settings > API Keys
# 3. LEAD_FROM precisa usar o domínio verificado, senão a Resend recusa o envio
RESEND_API_KEY=
LEAD_FROM="Site Conceitto <site@imobiliariaconceitto.com.br>"

# Caixa que recebe o lead quando não há endereço específico da unidade.
LEAD_INBOX=contato@imobiliariaconceitto.com.br

# Roteamento por unidade. O lead vai para a caixa da unidade que atende a cidade
# do imóvel ou do empreendimento. Deixar em branco manda tudo para LEAD_INBOX.
LEAD_INBOX_FARROUPILHA=
LEAD_INBOX_BENTO_GONCALVES=

# --- Entrega de lead por webhook (MSYS, n8n, Zapier) ---
# Recebe um POST JSON com lead, unidade, imóvel e empreendimento.
LEAD_WEBHOOK_URL=
# Enviado no header `authorization`, quando o endpoint exigir token.
LEAD_WEBHOOK_TOKEN=

# --- Origem pública ---
# Usada para montar os links absolutos dentro do e-mail. Na Vercel é detectada
# sozinha; defina apenas quando o domínio final estiver apontado.
NEXT_PUBLIC_SITE_URL=
